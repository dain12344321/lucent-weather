{
  "name": "clear-weather",
  "version": "0.5.0",
  "description": "Independent weather and daylight companion",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.cjs",
    "package": "electron-packager . ClearWeather --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/(dist|test.cjs|taskbar.ps1|style.css|.github|.git)(/|$)\" --extra-resource=Geometry.exe",
    "build:helper": "powershell.exe -NoProfile -File ./build-helper.ps1"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "@electron/packager": "20.3.0"
  }
}
