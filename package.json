{
  "name": "lucent-weather",
  "version": "0.9.3",
  "description": "Independent weather and daylight companion",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.cjs \"*.test.cjs\"",
    "build:icon": "node build-icon.cjs",
    "build:helper": "node build-helper.cjs",
    "package": "npm run build:icon && npm run build:helper && node scripts/package.cjs",
    "build:release": "npm run package && node scripts/stage-release.cjs"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.2.0"
  }
}
